# Copy to .env next to docker-compose.yml, or just run ./install.sh which
# generates this file for you.

# Required. Signs session cookies - keep it secret and stable across updates.
#   openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# First-run admin account. Only used while the database is empty.
# Leave ADMIN_PASSWORD empty to have one generated and printed to the container log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional. Enables YouTube playlist import and in-app search.
# Create at https://console.cloud.google.com -> APIs & Services -> YouTube Data API v3
# You can also paste this later under Admin -> Settings -> Integrations.
YOUTUBE_API_KEY=

# Port on the host. Your Cloudflare tunnel points here.
HOST_PORT=8080

# Where the database and uploads live. Two valid forms:
#   wwf-data              the Docker volume declared in the compose file
#   /mnt/tank/apps/wwf    any ABSOLUTE host path (must be writable by uid 1000)
# Any other value fails with "refers to undefined volume".
DATA_PATH=wwf-data

# Informational only - used by install.sh to print your public URL.
PUBLIC_DOMAIN=

TZ=Europe/Berlin
