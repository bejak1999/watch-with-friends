# Normalise line endings in the repository.
* text=auto

# These are executed on Linux - CRLF would make the shebang unusable.
*.sh          text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Binary-ish files git should not touch.
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
